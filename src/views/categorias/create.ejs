<section>
    <h1>Nueva Categoría</h1>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/categorias" method="POST">
        <%- include('forms') %>
        <button type="submit">Guardar Categoría</button>
        <a href="/categorias">Cancelar</a>
    </form>
</section>