<%# INICIO: "mesa de guardia". Recibe del controlador:
    recorrido, totalSolicitudes, enEspera, totalPendientes y accesos. %>

<%# --- Portada: saludo y botón principal --- %>
<section class="guardia">
    <div>
        <p class="guardia__etiqueta">Administrador activo.</p>
        <h1>Hola, <%= admin.name.split(' ')[0] %></h1>
        <p class="guardia__fecha"><%= new Date().toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' }) %></p>
    </div>
    <a class="guardia__boton" href="/solicitudes/create">+ Nueva solicitud</a>
</section>

<%# --- El recorrido de una solicitud, paso a paso --- %>
<section class="bloque">
    <h2>Estado de solicitudes.</h2>
    <ol class="recorrido">
        <% recorrido.forEach((paso, i) => { %>
            <li class="paso paso--<%= paso.clave %>">
                <a href="/solicitudes">
                    <span class="paso__numero"><%= paso.cantidad %></span>
                    <span class="paso__titulo"><%= paso.titulo %></span>
                </a>
            </li>
        <% }) %>
    </ol>
    <p class="bloque__nota">
        <%= totalSolicitudes %> <%= totalSolicitudes === 1 ? 'solicitud en total' : 'solicitudes en total' %>.
        Cada una avanza paso a paso hasta finalizar (o se cancela).
    </p>
</section>

<%# --- Quién espera atención ahora --- %>
<section class="bloque">
    <h2>Esperando atención</h2>

    <% if (enEspera.length === 0) { %>
        <p class="todo-al-dia">Todo al día: no hay solicitudes pendientes.</p>
    <% } else { %>
        <div class="cola">
            <% enEspera.forEach((s) => { %>
                <article class="urgencia">
                    <div class="urgencia__cabecera">
                        <strong><%= s.category_name || 'Sin categoría' %></strong>
                        <span class="urgencia__hace"><%= s.hace %></span>
                    </div>
                    <p class="urgencia__lugar"><%= s.zone_name || 'Sin zona' %> · <%= s.address %></p>
                    <p class="urgencia__cliente"><%= s.user_name %> · <%= s.user_phone %></p>
                    <a class="urgencia__boton" href="/solicitudes/<%= s.id %>/edit">Atender</a>
                </article>
            <% }) %>
        </div>
        <% if (totalPendientes > enEspera.length) { %>
            <p class="bloque__nota">Y <%= totalPendientes - enEspera.length %> más. <a href="/solicitudes">Ver todas las solicitudes</a></p>
        <% } %>
    <% } %>
</section>

<%# --- Accesos rápidos a los datos que se cargan --- %>
<section class="bloque">
    <h2>Datos del sistema</h2>
    <div class="accesos">
        <a class="acceso" href="/profesionales">
            <span class="acceso__numero"><%= accesos.profesionales %></span>
            <span>Profesionales<br><small><%= accesos.disponibles %> disponibles</small></span>
        </a>
        <a class="acceso" href="/usuarios">
            <span class="acceso__numero"><%= accesos.clientes %></span>
            <span>Clientes</span>
        </a>
        <a class="acceso" href="/categorias">
            <span class="acceso__numero"><%= accesos.categorias %></span>
            <span>Categorías</span>
        </a>
        <a class="acceso" href="/zonas">
            <span class="acceso__numero"><%= accesos.zonas %></span>
            <span>Zonas</span>
        </a>
    </div>
</section>
