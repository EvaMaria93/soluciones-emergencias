PORT=3000
# En el hosting poné NODE_ENV=production
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=soluciones_emergencias
DB_SSL=false

# Frase larga y secreta que firma la cookie de sesión. Inventá una propia y no la compartas.
SESSION_SECRET=


SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Mail donde el administrador recibe los avisos de nuevas solicitudes :
# 
ADMIN_EMAIL=
# Remitente que verán los destinatarios 
MAIL_FROM="Soluciones de Emergencia" <no-reply@soluciones-emergencias.test>
# Dirección pública de la app, para los enlaces de los mails (en el hosting, la URL real)
APP_URL=http://localhost:3000
